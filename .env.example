# Copy to .env for local development. Replace every CHANGE_ME value.
INCIDENTGRAPH_ENVIRONMENT=local
INCIDENTGRAPH_API_HOST=127.0.0.1
INCIDENTGRAPH_API_PORT=8000
INCIDENTGRAPH_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Use URL-safe passwords. Keep these values equal to the corresponding
# passwords embedded in the two DSNs below.
INCIDENTGRAPH_APP_DB_PASSWORD=CHANGE_ME
INCIDENTGRAPH_LAB_DB_PASSWORD=CHANGE_ME

INCIDENTGRAPH_APP_DATABASE_DSN=postgresql://incidentgraph:CHANGE_ME@127.0.0.1:55432/incidentgraph
INCIDENTGRAPH_LAB_DATABASE_DSN=postgresql://lab:CHANGE_ME@127.0.0.1:55433/lab
INCIDENTGRAPH_NEO4J_URI=bolt://127.0.0.1:57687
INCIDENTGRAPH_NEO4J_USER=neo4j
INCIDENTGRAPH_NEO4J_PASSWORD=CHANGE_ME
INCIDENTGRAPH_LAB_CONTROL_TOKEN=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS

INCIDENTGRAPH_LAB_GATEWAY_URL=http://127.0.0.1:58080
INCIDENTGRAPH_LAB_CHECKOUT_URL=http://127.0.0.1:58081
INCIDENTGRAPH_LAB_PAYMENTS_URL=http://127.0.0.1:58082
INCIDENTGRAPH_PROMETHEUS_URL=http://127.0.0.1:59090
INCIDENTGRAPH_LAB_REDIS_URL=redis://127.0.0.1:56379/0

# JSON map keyed by SHA-256 token hash. Generate a hash with:
# .tools/uv run incidentgraph hash-token
INCIDENTGRAPH_AUTH_TOKENS_JSON={}

INCIDENTGRAPH_WORKER_ID=local-worker-1
INCIDENTGRAPH_WORKER_LEASE_SECONDS=30
INCIDENTGRAPH_EVENT_RETENTION_DAYS=30
INCIDENTGRAPH_LOG_LEVEL=INFO

# Disabled until explicit provider and budget approval.
INCIDENTGRAPH_MODEL_PROVIDER=disabled
INCIDENTGRAPH_MODEL_ID=
INCIDENTGRAPH_MODEL_MAX_CALLS=10
INCIDENTGRAPH_MODEL_COST_CEILING_USD=0

# Local CPU embeddings. The revision is immutable and the generated cache stays
# under the ignored project-local models directory.
INCIDENTGRAPH_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
INCIDENTGRAPH_EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
INCIDENTGRAPH_EMBEDDING_DIMENSION=384
INCIDENTGRAPH_EMBEDDING_DEVICE=cpu
INCIDENTGRAPH_EMBEDDING_BATCH_SIZE=16
INCIDENTGRAPH_CORPUS_ID=incidentgraph-lab-corpus-v1
